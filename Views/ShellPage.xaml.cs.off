using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using OpenClawAdapter.ViewModels;

namespace OpenClawAdapter.Views;

public partial class ShellPage : Page
{
    private bool isInitialized;

    public MainViewModel ViewModel { get; } = AppState.ViewModel;

    public ShellPage()
    {
        InitializeComponent();
        DataContext = ViewModel;
    }

    private void OnLoaded(object sender, RoutedEventArgs e)
    {
        if (isInitialized)
        {
            return;
        }

        isInitialized = true;
        ContentFrame.Navigate(typeof(MainPage));
        if (NavView.MenuItems.Count > 0)
        {
            NavView.SelectedItem = NavView.MenuItems[0];
        }
    }

    private void OnNavigationSelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)
    {
        if (args.SelectedItem is not NavigationViewItem item || item.Tag is null)
        {
            return;
        }

        var tag = item.Tag.ToString();
        switch (tag)
        {
            case "dashboard":
                ContentFrame.Navigate(typeof(MainPage));
                break;
            case "subscriptions":
                ContentFrame.Navigate(typeof(SubscriptionsPage));
                break;
            case "settings":
                ContentFrame.Navigate(typeof(SettingsPage));
                break;
            case "logs":
                ContentFrame.Navigate(typeof(LogsPage));
                break;
            case "guide":
                ContentFrame.Navigate(typeof(GuidePage));
                break;
            default:
                ContentFrame.Navigate(typeof(MainPage));
                break;
        }
    }
}

<Page
    x:Class="OpenClawAdapter.Views.RootPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="NavLabelText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Storyboard x:Name="FluidMotionStoryboard">
            <DoubleAnimation Storyboard.TargetName="GlowATransform" Storyboard.TargetProperty="TranslateX" Duration="0:01:00" To="120" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowATransform" Storyboard.TargetProperty="TranslateY" Duration="0:01:08" To="90" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowATransform" Storyboard.TargetProperty="ScaleX" Duration="0:01:20" To="1.06" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowATransform" Storyboard.TargetProperty="ScaleY" Duration="0:01:24" To="1.06" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="GlowBTransform" Storyboard.TargetProperty="TranslateX" Duration="0:01:12" To="-150" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowBTransform" Storyboard.TargetProperty="TranslateY" Duration="0:01:18" To="-110" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowBTransform" Storyboard.TargetProperty="ScaleX" Duration="0:01:34" To="1.08" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowBTransform" Storyboard.TargetProperty="ScaleY" Duration="0:01:40" To="1.08" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="GlowCTransform" Storyboard.TargetProperty="TranslateX" Duration="0:00:58" To="95" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowCTransform" Storyboard.TargetProperty="TranslateY" Duration="0:01:04" To="-70" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowCTransform" Storyboard.TargetProperty="ScaleX" Duration="0:01:16" To="1.05" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowCTransform" Storyboard.TargetProperty="ScaleY" Duration="0:01:22" To="1.05" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowC" Storyboard.TargetProperty="Opacity" Duration="0:01:10" To="0.65" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="GlowDTransform" Storyboard.TargetProperty="TranslateX" Duration="0:01:30" To="-70" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowDTransform" Storyboard.TargetProperty="TranslateY" Duration="0:01:38" To="80" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowDTransform" Storyboard.TargetProperty="ScaleX" Duration="0:01:48" To="1.07" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowDTransform" Storyboard.TargetProperty="ScaleY" Duration="0:01:54" To="1.07" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowD" Storyboard.TargetProperty="Opacity" Duration="0:01:24" To="0.38" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="GlowETransform" Storyboard.TargetProperty="TranslateX" Duration="0:01:10" To="130" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowETransform" Storyboard.TargetProperty="TranslateY" Duration="0:01:20" To="-90" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowETransform" Storyboard.TargetProperty="ScaleX" Duration="0:01:32" To="1.09" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowETransform" Storyboard.TargetProperty="ScaleY" Duration="0:01:38" To="1.09" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowE" Storyboard.TargetProperty="Opacity" Duration="0:01:18" To="0.5" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="GlowFTransform" Storyboard.TargetProperty="TranslateX" Duration="0:02:10" To="-140" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowFTransform" Storyboard.TargetProperty="TranslateY" Duration="0:02:22" To="120" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowFTransform" Storyboard.TargetProperty="ScaleX" Duration="0:02:40" To="1.08" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowFTransform" Storyboard.TargetProperty="ScaleY" Duration="0:02:34" To="1.08" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowF" Storyboard.TargetProperty="Opacity" Duration="0:01:50" To="0.42" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="GlowGTransform" Storyboard.TargetProperty="TranslateX" Duration="0:01:55" To="160" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowGTransform" Storyboard.TargetProperty="TranslateY" Duration="0:02:05" To="-130" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowGTransform" Storyboard.TargetProperty="ScaleX" Duration="0:02:18" To="1.07" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowGTransform" Storyboard.TargetProperty="ScaleY" Duration="0:02:24" To="1.07" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GlowG" Storyboard.TargetProperty="Opacity" Duration="0:02:00" To="0.36" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="SheenATransform" Storyboard.TargetProperty="TranslateX" Duration="0:01:40" To="220" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="SheenATransform" Storyboard.TargetProperty="TranslateY" Duration="0:01:52" To="-140" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="SheenATransform" Storyboard.TargetProperty="Rotation" Duration="0:02:10" To="18" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="SheenBTransform" Storyboard.TargetProperty="TranslateX" Duration="0:02:05" To="-240" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="SheenBTransform" Storyboard.TargetProperty="TranslateY" Duration="0:01:50" To="160" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="SheenBTransform" Storyboard.TargetProperty="Rotation" Duration="0:02:30" To="-14" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>

        <Style x:Key="NavItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="HoverLayer" Margin="3,2" CornerRadius="13" Background="#120C1524" BorderBrush="{ThemeResource NavPaneLineBrush}" BorderThickness="1" Opacity="0" />
                            <Border x:Name="SelectGlow" Margin="3,2" CornerRadius="13" Background="{ThemeResource NavPaneGlowBrush}" Opacity="0" />
                            <Border x:Name="SelectLayer" Margin="3,2" CornerRadius="13" Background="{ThemeResource NavSelectionFillBrush}" BorderBrush="{ThemeResource NavSelectionBorderBrush}" BorderThickness="1" Opacity="0" />
                            <Border x:Name="SelectAccent" Margin="7,8,0,8" Width="3" CornerRadius="2" Background="{ThemeResource AccentBlueBrush}" HorizontalAlignment="Left" Opacity="0" />
                            <Border x:Name="PressedLayer" Margin="3,2" CornerRadius="13" Background="#2810192D" Opacity="0" />
                            <Border x:Name="ItemBorder" Margin="3,2" CornerRadius="13" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Padding="0,4" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="ItemTransform" />
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="TranslateY" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleX" To="0.972" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="ScaleY" To="0.972" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="ItemTransform" Storyboard.TargetProperty="TranslateY" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="SelectGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="SelectAccent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextMutedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectGlow" Storyboard.TargetProperty="Opacity" To="0.82" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelectAccent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBlueBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="ShellRoot" Background="{ThemeResource AppBackgroundBrush}" RenderTransformOrigin="0,0" SizeChanged="OnShellRootSizeChanged">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Canvas x:Name="FluidCanvas" IsHitTestVisible="False" Opacity="0.68">
            <Ellipse x:Name="GlowA" Canvas.Left="-180" Canvas.Top="-160" Fill="{ThemeResource GlowPrimaryBrush}" Height="420" Width="420" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="GlowATransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowB" Canvas.Left="760" Canvas.Top="420" Fill="{ThemeResource GlowSecondaryBrush}" Height="360" Width="360" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="GlowBTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowC" Canvas.Left="240" Canvas.Top="120" Fill="{ThemeResource GlowPrimaryBrush}" Height="260" Width="260" Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="GlowCTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowD" Canvas.Left="80" Canvas.Top="520" Fill="{ThemeResource GlowSecondaryBrush}" Height="520" Width="520" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="GlowDTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowE" Canvas.Left="640" Canvas.Top="-120" Fill="{ThemeResource GlowSecondaryBrush}" Height="300" Width="300" Opacity="0.32" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="GlowETransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowF" Canvas.Left="980" Canvas.Top="-260" Fill="{ThemeResource GlowPrimaryBrush}" Height="560" Width="560" Opacity="0.2" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="GlowFTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowG" Canvas.Left="-260" Canvas.Top="360" Fill="{ThemeResource GlowSecondaryBrush}" Height="620" Width="620" Opacity="0.18" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="GlowGTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Rectangle x:Name="SheenA" Canvas.Left="-120" Canvas.Top="80" Width="520" Height="280" Opacity="0.28" Fill="{ThemeResource FlowSheenPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <CompositeTransform x:Name="SheenATransform" Rotation="8" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="SheenB" Canvas.Left="520" Canvas.Top="280" Width="520" Height="320" Opacity="0.24" Fill="{ThemeResource FlowSheenSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <CompositeTransform x:Name="SheenBTransform" Rotation="-10" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <Grid x:Name="JellyfishLayer" IsHitTestVisible="False" Opacity="0.9" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="6,3">
                <Border
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource ToolbarBackgroundBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="10,7">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2" MaxWidth="440">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="6" Height="20" Width="20" VerticalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/ClashForClaw-icon-preview.png" Stretch="Uniform" Margin="2" />
                                </Border>
                                <TextBlock Style="{StaticResource BrandText}" FontSize="19" Text="Clash for Claw" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource MutedText}"
                                FontSize="12"
                                Text="{Binding ShellResidencyText}" />
                            <TextBlock
                                Style="{StaticResource MutedText}"
                                FontSize="12"
                                Text="{Binding ConnectivitySummary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Border Style="{StaticResource TopStatusChip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ConnectionStatusBrush}" VerticalAlignment="Center" />
                                    <TextBlock
                                        Foreground="{Binding ConnectionStatusBrush}"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Text="{Binding ConnectionState}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TopStatusChip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ModeStatusBrush}" VerticalAlignment="Center" />
                                    <TextBlock
                                        Foreground="{Binding ModeStatusBrush}"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Text="{Binding ModeSummary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource TopStatusChip}">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    FontSize="12"
                                    Text="{Binding TrafficUpdatedAtText}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="↑" Foreground="{ThemeResource AccentBlueBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding TrafficUpRateText}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="↓" Foreground="{ThemeResource AccentBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding TrafficDownRateText}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="6,2,6,6" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource NavPaneBackgroundBrush}" BorderBrush="{ThemeResource NavPaneBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <ListView
                            x:Name="NavList"
                            SelectionChanged="OnNavSelectionChanged"
                            SelectedIndex="0"
                            HorizontalContentAlignment="Stretch"
                            Padding="0,10,0,8"
                            ItemContainerStyle="{StaticResource NavItemStyle}">
                            <ListViewItem x:Name="NavItemDashboard" Tag="dashboard" ToolTipService.ToolTip="概览">
                                <Grid x:Name="NavGridDashboard" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NavIconColumnDashboard" Width="32" />
                                        <ColumnDefinition x:Name="NavLabelColumnDashboard" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Home" Foreground="{Binding Foreground, ElementName=NavItemDashboard}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="NavLabelDashboard" Grid.Column="1" VerticalAlignment="Center" Opacity="0" Foreground="{Binding Foreground, ElementName=NavItemDashboard}" Style="{StaticResource NavLabelText}" Text="概览" />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem x:Name="NavItemSubscriptions" Tag="subscriptions" ToolTipService.ToolTip="订阅">
                                <Grid x:Name="NavGridSubscriptions" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NavIconColumnSubscriptions" Width="32" />
                                        <ColumnDefinition x:Name="NavLabelColumnSubscriptions" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Download" Foreground="{Binding Foreground, ElementName=NavItemSubscriptions}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="NavLabelSubscriptions" Grid.Column="1" VerticalAlignment="Center" Opacity="0" Foreground="{Binding Foreground, ElementName=NavItemSubscriptions}" Style="{StaticResource NavLabelText}" Text="订阅" />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem x:Name="NavItemSettings" Tag="settings" ToolTipService.ToolTip="设置">
                                <Grid x:Name="NavGridSettings" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NavIconColumnSettings" Width="32" />
                                        <ColumnDefinition x:Name="NavLabelColumnSettings" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Setting" Foreground="{Binding Foreground, ElementName=NavItemSettings}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="NavLabelSettings" Grid.Column="1" VerticalAlignment="Center" Opacity="0" Foreground="{Binding Foreground, ElementName=NavItemSettings}" Style="{StaticResource NavLabelText}" Text="设置" />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem x:Name="NavItemLogs" Tag="logs" ToolTipService.ToolTip="日志与高级">
                                <Grid x:Name="NavGridLogs" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NavIconColumnLogs" Width="32" />
                                        <ColumnDefinition x:Name="NavLabelColumnLogs" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Document" Foreground="{Binding Foreground, ElementName=NavItemLogs}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="NavLabelLogs" Grid.Column="1" VerticalAlignment="Center" Opacity="0" Foreground="{Binding Foreground, ElementName=NavItemLogs}" Style="{StaticResource NavLabelText}" Text="日志与高级" />
                                </Grid>
                            </ListViewItem>
                            <ListViewItem x:Name="NavItemGuide" Tag="guide" ToolTipService.ToolTip="说明">
                                <Grid x:Name="NavGridGuide" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NavIconColumnGuide" Width="32" />
                                        <ColumnDefinition x:Name="NavLabelColumnGuide" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Help" Foreground="{Binding Foreground, ElementName=NavItemGuide}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="NavLabelGuide" Grid.Column="1" VerticalAlignment="Center" Opacity="0" Foreground="{Binding Foreground, ElementName=NavItemGuide}" Style="{StaticResource NavLabelText}" Text="说明" />
                                </Grid>
                            </ListViewItem>
                        </ListView>

                        <Border VerticalAlignment="Top" Height="1" Background="{ThemeResource NavPaneTopLineBrush}" Opacity="0.7" IsHitTestVisible="False" />
                        <Border VerticalAlignment="Bottom" Height="1" Background="{ThemeResource NavPaneBottomLineBrush}" Opacity="0.6" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource ContentBackgroundBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0" CornerRadius="12" Padding="2">
                    <Frame x:Name="ContentFrame" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>




















                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NavSelectionFillBrush" Color="#54E8FBFF" />
                    <SolidColorBrush x:Key="NavSelectionBorderBrush" Color="#9222D3EE" />
                    <SolidColorBrush x:Key="NavPaneLineBrush" Color="#B322D3EE" />
                    <SolidColorBrush x:Key="NavPaneTopLineBrush" Color="#6622D3EE" />
                    <SolidColorBrush x:Key="NavPaneBottomLineBrush" Color="#4A2DD4BF" />
                    <SolidColorBrush x:Key="SubscriptionInactiveBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="SubscriptionTrackBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />

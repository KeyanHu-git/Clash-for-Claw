<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClashForClaw.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="LogsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid x:Name="LogsLayoutRoot">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleText}" Text="日志" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="统一查看桌面模式与 Windows 服务模式的日志位置。"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border Style="{StaticResource HeroCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="日志记录位置" />
                            <TextBlock
                                Style="{StaticResource MutedText}"
                                Text="{Binding LogLocationHint}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Border Style="{StaticResource InsetPanel}">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource MutedText}" Text="桌面日志目录" />
                                <StackPanel Grid.Row="1" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding LogDirectoryPath}" TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="OnPickLogDirectoryClicked" Content="选择目录" />
                                        <Button Click="OnOpenLogDirectoryClicked" Content="打开目录" />
                                        <Button
                                            Click="OnResetLogDirectoryClicked"
                                            Content="恢复默认"
                                            IsEnabled="{Binding IsCustomLogDirectory}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="当前生效日志" />
                                <TextBlock
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    FontWeight="SemiBold"
                                    Text="{Binding ActiveLogFilePath}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource InsetPanel}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource PanelLabelText}" Text="最近重载" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding LastReloadText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid x:Name="LogsCardsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="LogsColumnB" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="LoggingCard" Style="{StaticResource LogsCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="调试日志" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="仅在排查问题时启用，平时保持关闭即可。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                Header="启用调试日志"
                                IsOn="{Binding DebugLoggingEnabled, Mode=TwoWay}" />

                            <Border Style="{StaticResource InsetPanel}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource PanelLabelText}" Text="桌面侧日志文件" />
                                    <TextBlock Text="{Binding DesktopLogFilePath}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{Binding SettingsLogPath}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{Binding CrashLogPath}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AdvancedCard" Grid.Row="1" Style="{StaticResource LogsCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Windows 服务日志" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="服务模式由 LocalService 账户运行，日志固定写入服务目录。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Border Style="{StaticResource InsetPanel}">
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource PanelLabelText}" Text="服务日志目录" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding ServiceLogDirectory}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ServiceLogPath}" TextWrapping="WrapWholeWords" />
                                    <Button
                                        Click="OnOpenServiceLogDirectoryClicked"
                                        Content="打开服务目录"
                                        HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

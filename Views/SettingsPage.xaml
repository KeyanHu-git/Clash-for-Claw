<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="OpenClawAdapter.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="5,3,5,5" Spacing="5">
            <TextBlock Style="{StaticResource TitleText}" Text="设置" />

            <InfoBar
                IsClosable="True"
                IsOpen="{Binding IsServiceModeMessageOpen, Mode=TwoWay}"
                Message="{Binding ServiceModeMessage}"
                Severity="{Binding ServiceModeSeverity}"
                Title="后台模式" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="当前后台形态" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding BackgroundProfileTitle}" />
                        <TextBlock
                            Style="{StaticResource MutedText}"
                            Text="{Binding BackgroundProfileDetail}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Style="{StaticResource MutedText}"
                            Text="{Binding DesktopResidencySummary}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource SurfaceAltBrush}"
                        CornerRadius="999"
                        Padding="10,5"
                        VerticalAlignment="Top">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{Binding ModeStatusBrush}"
                            Text="{Binding BackgroundProfileTitle}" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="桌面后台" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="适合日常使用：保留可视化界面、托盘和快速排障能力。"
                        TextWrapping="WrapWholeWords" />
                    <ToggleSwitch
                        Header="开机自启动"
                        IsEnabled="{Binding DesktopResidencyOptionsEnabled}"
                        IsOn="{Binding AutoStartEnabled, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="启动后静默运行"
                        OffContent="显示主界面"
                        OnContent="最小化到托盘"
                        IsEnabled="{Binding DesktopResidencyOptionsEnabled}"
                        IsOn="{Binding SilentOnBootEnabled, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="关闭窗口最小化到托盘"
                        IsEnabled="{Binding DesktopResidencyOptionsEnabled}"
                        IsOn="{Binding CloseToTrayEnabled, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="{Binding DesktopResidencySummary}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="服务模式（高级）" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="完全静默运行，无窗口、无托盘。"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Style="{StaticResource MutedText}"
                                Text="{Binding ServiceModeHint}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="ServiceModeSwitch"
                            Grid.Column="1"
                            Header=""
                            OffContent="桌面后台"
                            OnContent="完全静默"
                            IsOn="{Binding ServiceModeEnabled, Mode=TwoWay}"
                            Toggled="OnServiceModeToggled"
                            VerticalAlignment="Top" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="10" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="服务账户" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding ServiceModeAccountText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="10" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="服务数据目录" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding ServiceModeDataPath}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="订阅策略" />
                    <NumberBox
                        Header="订阅流量刷新周期（小时）"
                        Minimum="1"
                        Maximum="168"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding SubscriptionRefreshHours, Mode=TwoWay}"
                        ValueChanged="OnSubscriptionRefreshChanged" />
                    <NumberBox
                        Header="网关探测周期（分钟）"
                        Minimum="1"
                        Maximum="1440"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding SubscriptionProbeMinutes, Mode=TwoWay}"
                        ValueChanged="OnSubscriptionProbeChanged" />
                    <NumberBox
                        Header="订阅列表列数"
                        Minimum="1"
                        Maximum="3"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding SubscriptionColumns, Mode=TwoWay}"
                        ValueChanged="OnSubscriptionColumnsChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
                    <ComboBox
                        Header="主题"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding ThemeMode, Mode=TwoWay}">
                        <ComboBoxItem Content="系统跟随" Tag="System" />
                        <ComboBoxItem Content="暗夜" Tag="Dark" />
                        <ComboBoxItem Content="浅色" Tag="Light" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="CLI 运行" />
                    <ToggleSwitch
                        Header="自动运行 CLI"
                        IsOn="{Binding AutoRunCliEnabled, Mode=TwoWay}" />
                    <TextBox
                        Header="CLI 可执行文件"
                        Style="{StaticResource InputTextBox}"
                        Text="{Binding CliPath, Mode=TwoWay}"
                        PlaceholderText="OpenClaw-Adapter.exe" />
                    <TextBox
                        Header="CLI 启动参数"
                        Style="{StaticResource InputTextBox}"
                        Text="{Binding CliArgs, Mode=TwoWay}"
                        PlaceholderText="--daemon" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="网络与安全" />
                    <TextBox
                        Header="本地端口"
                        Style="{StaticResource InputTextBox}"
                        Text="{Binding LocalPort, Mode=TwoWay}"
                        PlaceholderText="7890"
                        LostFocus="OnLocalPortLostFocus" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="系统代理开关已迁移到“概览”页，默认关闭。"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

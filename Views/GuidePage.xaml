<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClashForClaw.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClashForClaw"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="GuideCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid x:Name="GuideLayoutRoot">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleText}" Text="说明" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="把运行逻辑、回退策略和接口边界集中说明，避免每次临时查找。"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border Style="{StaticResource HeroCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="默认工作方式" />
                        <Border Style="{StaticResource InsetPanel}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="仅回环使用，与本机流量隔离。" />
                                <TextBlock Text="系统代理默认关闭，可按需手动开启。" />
                                <TextBlock Text="订阅展示仅反映代理链路本身的状态与流量。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid x:Name="GuideCardsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="GuideColumnB" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="GuidePrinciplesCard" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="核心原则" />
                            <TextBlock Style="{StaticResource MutedText}" Text="默认只做本机适配层，不扩展额外网络面。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="订阅优先，保持入口简洁；不强制改系统级网络设置。" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideModesCard" Grid.Row="1" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="模式与回退" />
                            <TextBlock Text="订阅模式默认；失败时自动回退本地端口。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="订阅缺失时自动使用本地端口配置。" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideInterfacesCard" Grid.Row="2" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="接口与日志" />
                            <TextBlock Text="本地 API：/health /status /config /config/reload /service/*" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="URL 含 token 将自动解析，不会在输入框里回显。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="日志仅保存在本机，不上传。" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideServiceCard" Grid.Row="3" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="服务驻留" />
                            <TextBlock Text="服务模式启用后 UI 与托盘不显示。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="服务注册失败时会自动降级为计划任务。" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideCreditsCard" Grid.Row="4" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="动态背景致谢" />
                            <TextBlock Text="本项目来源于和鲸社区，使用转载需要标注来源。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="数学公式下的生命构型与动态（和鲸社区转载）" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="作者：Shelter / MrIShelter（2025/08/04）" />
                            <TextBlock Text="来源：https://www.heywhale.com/mw/project/687e3f38c678037e34ebf61e" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="OpenClawAdapter.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OpenClawAdapter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="5,3,5,5" Spacing="5">
            <TextBlock Style="{StaticResource TitleText}" Text="说明" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="核心原则" />
                    <TextBlock Text="仅回环使用，与本机流量隔离。" />
                    <TextBlock Text="系统代理默认关闭，可按需手动开启。" />
                    <TextBlock Text="订阅展示仅反映代理链路本身的状态与流量。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="模式与回退" />
                    <TextBlock Text="订阅模式默认；失败时自动回退本地端口。" />
                    <TextBlock Text="订阅缺失时自动使用本地端口配置。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="接口与日志" />
                    <TextBlock
                        Text="本地 API：/health /status /config /config/reload /service/*"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock Text="URL 含 token 将自动解析（不回显）。" />
                    <TextBlock Text="日志仅保存在本机，不上传。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="服务驻留" />
                    <TextBlock Text="服务模式启用后 UI 与托盘不显示。" />
                    <TextBlock Text="服务注册失败时自动降级为计划任务。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="动态背景致谢" />
                    <TextBlock Text="本项目来源于和鲸社区，使用转载需要标注来源。" />
                    <TextBlock Text="数学公式下的生命构型与动态（和鲸社区转载）" />
                    <TextBlock Text="作者：Shelter / MrIShelter（2025/08/04）" />
                    <TextBlock
                        Text="来源：https://www.heywhale.com/mw/project/687e3f38c678037e34ebf61e"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>





<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClashForClaw.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClashForClaw"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="LogsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid x:Name="LogsLayoutRoot">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleText}" Text="日志与高级" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="集中查看本机日志位置和当前调试开关，避免在多个页面分散寻找。"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border Style="{StaticResource HeroCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="运行痕迹" />
                        <Border Style="{StaticResource InsetPanel}">
                            <Grid ColumnSpacing="10" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource MutedText}" Text="日志文件位置" />
                                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{Binding LogFilePath}" TextWrapping="WrapWholeWords" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="最近热重载" />
                                <TextBlock Grid.Column="1" Grid.Row="1" FontWeight="SemiBold" HorizontalAlignment="Right" Text="{Binding LastReloadText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid x:Name="LogsCardsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="LogsColumnB" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="LoggingCard" Style="{StaticResource LogsCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="日志级别" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="只有在排查问题时才建议打开调试日志，平时保持关闭更干净。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                Header="启用调试日志"
                                IsOn="{Binding DebugLoggingEnabled, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="AdvancedCard" Grid.Row="1" Style="{StaticResource LogsCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="高级提示" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="配置修改后如果没有立即生效，可以优先对照热重载时间确认是否已经应用。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Border Style="{StaticResource InsetPanel}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource PanelLabelText}" Text="热重载状态" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding LastReloadText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

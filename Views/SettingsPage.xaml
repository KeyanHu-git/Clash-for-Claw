<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClashForClaw.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SettingsFormCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,9" />
        </Style>

        <Style x:Key="SettingsMicroLabel" TargetType="TextBlock" BasedOn="{StaticResource PanelLabelText}">
            <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid x:Name="SettingsLayoutRoot">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleText}" Text="设置" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="管理后台方式、更新策略、外观和本地入口。"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <InfoBar
                    IsClosable="True"
                    IsOpen="{Binding IsServiceModeMessageOpen, Mode=TwoWay}"
                    Message="{Binding ServiceModeMessage}"
                    Severity="{Binding ServiceModeSeverity}"
                    Title="后台方式" />

                <Border Style="{StaticResource HeroCard}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="当前后台方式" />
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding BackgroundProfileTitle}" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="{Binding BackgroundProfileDetail}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource MetaBadge}" VerticalAlignment="Top">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{Binding ModeStatusBrush}"
                                    Text="{Binding BackgroundProfileTitle}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="HeroMetricColumnB" Width="0" />
                                <ColumnDefinition x:Name="HeroMetricColumnC" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="HeroDesktopMetric" Style="{StaticResource MetricTile}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="当前驻留" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DesktopResidencySummary}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="HeroAccountMetric" Grid.Row="1" Style="{StaticResource MetricTile}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="运行账户" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding ServiceModeAccountText}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="HeroDataMetric" Grid.Row="2" Style="{StaticResource MetricTile}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="后台数据目录" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding ServiceModeDataPath}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="ResidencyGrid" ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ResidencyColumnB" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="DesktopCard" Grid.ColumnSpan="2" Style="{StaticResource SettingsFormCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="桌面后台" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="适合日常使用，保留主界面、托盘和快速排查能力。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ToggleSwitch
                                    Header="开机自动启动"
                                    IsEnabled="{Binding DesktopResidencyOptionsEnabled}"
                                    IsOn="{Binding AutoStartEnabled, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Grid.Row="1"
                                    Header="启动后静默运行"
                                    OffContent="显示主界面"
                                    OnContent="最小化到托盘"
                                    IsEnabled="{Binding DesktopResidencyOptionsEnabled}"
                                    IsOn="{Binding SilentOnBootEnabled, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Grid.Row="2"
                                    Header="关闭窗口时保留托盘"
                                    IsEnabled="{Binding DesktopResidencyOptionsEnabled}"
                                    IsOn="{Binding CloseToTrayEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Border Style="{StaticResource InsetPanel}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="当前效果" />
                                    <TextBlock
                                        Style="{StaticResource MutedText}"
                                        Text="{Binding DesktopResidencySummary}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ServiceCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsFormCard}">
                        <StackPanel Spacing="10">
                            <Grid x:Name="ServiceHeaderGrid" ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ServiceHeaderActionColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Windows 服务模式" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="启用后会尝试注册 Windows 服务。"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Style="{StaticResource MutedText}"
                                        Text="{Binding ServiceModeHint}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="ServiceModeSwitch"
                                    Grid.Row="1"
                                    OffContent="桌面后台"
                                    OnContent="Windows 服务"
                                    IsOn="{Binding ServiceModeEnabled, Mode=TwoWay}"
                                    Toggled="OnServiceModeToggled"
                                    VerticalAlignment="Top" />
                            </Grid>

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource MetricTile}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="运行账户" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ServiceModeAccountText}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource MetricTile}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="后台数据目录" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ServiceModeDataPath}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource InsetPanel}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="切换说明" />
                                    <TextBlock
                                        Style="{StaticResource MutedText}"
                                        Text="注册成功后前台可退出；若只回退为计划任务，会保留当前界面并提示原因。"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="DetailsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DetailsColumnB" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="StrategyCard" Grid.ColumnSpan="2" Style="{StaticResource SettingsFormCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="订阅更新" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="控制刷新周期、探测周期和列表密度。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <NumberBox
                                Header="刷新周期（小时）"
                                Minimum="1"
                                Maximum="168"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SubscriptionRefreshHours, Mode=TwoWay}"
                                ValueChanged="OnSubscriptionRefreshChanged" />
                            <NumberBox
                                Header="探测周期（分钟）"
                                Minimum="1"
                                Maximum="1440"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SubscriptionProbeMinutes, Mode=TwoWay}"
                                ValueChanged="OnSubscriptionProbeChanged" />
                            <NumberBox
                                Header="列表列数"
                                Minimum="1"
                                Maximum="3"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding SubscriptionColumns, Mode=TwoWay}"
                                ValueChanged="OnSubscriptionColumnsChanged" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="AppearanceCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsFormCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="主题会立即应用到主界面和背景层。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ComboBox
                                Header="主题"
                                SelectedValuePath="Tag"
                                SelectedValue="{Binding ThemeMode, Mode=TwoWay}">
                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                <ComboBoxItem Content="暗色" Tag="Dark" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                            </ComboBox>

                            <Border Style="{StaticResource InsetPanel}">
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="切换后立即生效，无需重启。"
                                    TextWrapping="WrapWholeWords" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CliCard" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SettingsFormCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="内置后台组件" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="默认使用安装包内置组件；只有维护自定义组件时才需要修改。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <ToggleSwitch
                                Header="自动启动内置后台"
                                IsOn="{Binding AutoRunCliEnabled, Mode=TwoWay}" />
                            <TextBox
                                Header="后台组件路径"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding CliPath, Mode=TwoWay}"
                                PlaceholderText="默认使用内置组件" />
                            <TextBox
                                Header="启动参数"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding CliArgs, Mode=TwoWay}"
                                PlaceholderText="--daemon" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="NetworkCard" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SettingsFormCard}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="本地入口" />
                                <TextBlock
                                    Style="{StaticResource MutedText}"
                                    Text="设置本地代理端口。系统代理开关已移到概览页。"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <TextBox
                                Header="本地端口"
                                Style="{StaticResource InputTextBox}"
                                Text="{Binding LocalPort, Mode=TwoWay}"
                                PlaceholderText="7890"
                                LostFocus="OnLocalPortLostFocus" />

                            <Border Style="{StaticResource InsetPanel}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SettingsMicroLabel}" Text="提醒" />
                                    <TextBlock
                                        Style="{StaticResource MutedText}"
                                        Text="仅在本地端口模式或明确修改入口时需要调整。"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

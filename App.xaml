                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#0EA5A5" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#0B948B" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#0EA5A5" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#0B948B" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorBrush" Color="#22D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1C0EA5A5" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#260EA5A5" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#300EA5A5" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#380EA5A5" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#420EA5A5" />
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#E6FFFB" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
                    <RadialGradientBrush x:Key="GlowPrimaryBrush" Center="0.5,0.5" GradientOrigin="0.35,0.35" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#6622D3EE" Offset="0" />
                        <GradientStop Color="#00112433" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlowSecondaryBrush" Center="0.5,0.5" GradientOrigin="0.6,0.4" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#550EA5A5" Offset="0" />
                        <GradientStop Color="#00112433" Offset="1" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="JellyfishBellBrush" Color="#3322D3EE" />
                    <SolidColorBrush x:Key="JellyfishTentacleBrush" Color="#442DD4BF" />
                    <RadialGradientBrush x:Key="JellyfishGlowBrush" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.65" RadiusY="0.65">
                        <GradientStop Color="#5522D3EE" Offset="0" />
                        <GradientStop Color="#00112433" Offset="1" />
                    </RadialGradientBrush>
                    <LinearGradientBrush x:Key="FlowSheenPrimaryBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0022D3EE" Offset="0" />
                        <GradientStop Color="#3A22D3EE" Offset="0.45" />
                        <GradientStop Color="#002DD4BF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="FlowSheenSecondaryBrush" StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#002DD4BF" Offset="0" />
                        <GradientStop Color="#262DD4BF" Offset="0.5" />
                        <GradientStop Color="#0022D3EE" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="StatusOkBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="StatusWarnBrush" Color="#D97706" />
                    <SolidColorBrush x:Key="StatusBadBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="StatusUnknownBrush" Color="#9CA3AF" />
                    <Color x:Key="FocusStrokeColorOuter">#8A0EA5A5</Color>
                    <Color x:Key="FocusStrokeColorInner">#F7FFFFFF</Color>
                    <SolidColorBrush x:Key="FocusOuterBrush" Color="#8A0EA5A5" />
                    <SolidColorBrush x:Key="FocusInnerBrush" Color="#F7FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8A0EA5A5" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#8A0EA5A5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#990B0F14" Offset="0" />
                        <GradientStop Color="#99101420" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#6610172A" />
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#4D10182E" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#7010182E" />
                    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#3810182E" />
                    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#8C10192E" />
                    <SolidColorBrush x:Key="InsetSurfaceBrush" Color="#66121F35" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="#08FFFFFF" />
                    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B3101B31" Offset="0" />
                        <GradientStop Color="#A0122238" Offset="0.55" />
                        <GradientStop Color="#8C102840" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HeroBorderBrush" Color="#5222D3EE" />
                    <SolidColorBrush x:Key="NavPaneBackgroundBrush" Color="#4D10192E" />
                    <LinearGradientBrush x:Key="NavPaneBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3A22D3EE" Offset="0" />
                        <GradientStop Color="#1E22D3EE" Offset="0.6" />
                        <GradientStop Color="#0822D3EE" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="NavPaneGlowBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#6A22D3EE" Offset="0" />
                        <GradientStop Color="#0022D3EE" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NavSelectionFillBrush" Color="#6A16263D" />
                    <SolidColorBrush x:Key="NavSelectionBorderBrush" Color="#AA22D3EE" />
                    <SolidColorBrush x:Key="NavPaneLineBrush" Color="#E022D3EE" />
                    <SolidColorBrush x:Key="NavPaneTopLineBrush" Color="#8022D3EE" />
                    <SolidColorBrush x:Key="NavPaneBottomLineBrush" Color="#5A2DD4BF" />
                    <SolidColorBrush x:Key="SubscriptionInactiveBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="SubscriptionTrackBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B1220" />
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#0B3B39" />
                    <SolidColorBrush x:Key="AccentBlueBrush" Color="#22D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#22D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#22D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#2DD4BF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#22D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#2DD4BF" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorBrush" Color="#22D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2422D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#2A2DD4BF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2A22D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#3322D3EE" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#342DD4BF" />
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#0B2D2B" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
                    <RadialGradientBrush x:Key="GlowPrimaryBrush" Center="0.5,0.5" GradientOrigin="0.35,0.35" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#552DD4BF" Offset="0" />
                        <GradientStop Color="#00060B16" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlowSecondaryBrush" Center="0.5,0.5" GradientOrigin="0.6,0.4" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#6622D3EE" Offset="0" />
                        <GradientStop Color="#00060B16" Offset="1" />
                    </RadialGradientBrush>
                    <SolidColorBrush x:Key="JellyfishBellBrush" Color="#3322D3EE" />
                    <SolidColorBrush x:Key="JellyfishTentacleBrush" Color="#552DD4BF" />
                    <RadialGradientBrush x:Key="JellyfishGlowBrush" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#7722D3EE" Offset="0" />
                        <GradientStop Color="#00060B16" Offset="1" />
                    </RadialGradientBrush>
                    <LinearGradientBrush x:Key="FlowSheenPrimaryBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0022D3EE" Offset="0" />
                        <GradientStop Color="#4422D3EE" Offset="0.45" />
                        <GradientStop Color="#002DD4BF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="FlowSheenSecondaryBrush" StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#002DD4BF" Offset="0" />
                        <GradientStop Color="#3422D3EE" Offset="0.5" />
                        <GradientStop Color="#0022D3EE" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="StatusOkBrush" Color="#22C55E" />
                    <SolidColorBrush x:Key="StatusWarnBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="StatusBadBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="StatusUnknownBrush" Color="#6B7280" />
                    <Color x:Key="FocusStrokeColorOuter">#AA22D3EE</Color>
                    <Color x:Key="FocusStrokeColorInner">#CC08131D</Color>
                    <SolidColorBrush x:Key="FocusOuterBrush" Color="#AA22D3EE" />
                    <SolidColorBrush x:Key="FocusInnerBrush" Color="#CC08131D" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#AA22D3EE" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#AA22D3EE" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Boolean x:Key="UseSystemFocusVisuals">False</x:Boolean>

            <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Microsoft YaHei UI</FontFamily>

            <Style x:Key="BaseTextBlock" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}" />

            <Thickness x:Key="PagePadding">10,8,10,10</Thickness>
            <Thickness x:Key="SectionSpacing">0,0,0,8</Thickness>
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <Thickness x:Key="CardPadding">10,8</Thickness>
            <CornerRadius x:Key="NavigationViewItemCornerRadius">7</CornerRadius>

            <Style x:Key="BrandText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <Style x:Key="PanelLabelText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <Style x:Key="TopStatusChip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceStrongBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceStrongBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Background" Value="{ThemeResource HeroBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HeroBorderBrush}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="12,11,12,10" />
            </Style>

            <Style x:Key="InsetPanel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InsetSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="9,8" />
            </Style>

            <Style x:Key="MetricTile" TargetType="Border" BasedOn="{StaticResource InsetPanel}">
                <Setter Property="Padding" Value="9,8" />
            </Style>

            <Style x:Key="MetaBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,3" />
            </Style>

            <Style x:Key="InputTextBox" TargetType="TextBox">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="Background" Value="{ThemeResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="Background" Value="{ThemeResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="ToolbarButton" TargetType="AppBarButton">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource FocusInnerBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            </Style>

            <Style x:Key="ToolbarToggleButton" TargetType="AppBarToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource FocusInnerBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource FocusInnerBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>

            <Style x:Key="SubtleButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="Background" Value="{ThemeResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource FocusInnerBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>

            <Style x:Key="OverviewSecondaryButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentBlueBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
            </Style>

            <Style x:Key="OverviewSelectedButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Background" Value="{ThemeResource NavigationViewItemBackgroundSelected}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentBlueBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NavSelectionBorderBrush}" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource AccentBlueBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource FocusInnerBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>

            <x:Double x:Key="NavigationViewItemMinHeight">28</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>


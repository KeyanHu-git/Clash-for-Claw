                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="InsetSurfaceBrush" Color="#CCF6FAFF" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="#08000000" />
                    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#DDF6FBFF" Offset="0.6" />
                        <GradientStop Color="#CCE7F7FF" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HeroBorderBrush" Color="#4D22D3EE" />
                    <SolidColorBrush x:Key="NavPaneBackgroundBrush" Color="#66FFFFFF" />

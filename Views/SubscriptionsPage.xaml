<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="OpenClawAdapter.Views.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:OpenClawAdapter.Controls"
    xmlns:local="using:OpenClawAdapter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SubscriptionListItem" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubscriptionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid x:Name="ContentLayout" Padding="5,3,5,5" RowSpacing="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleText}" Text="订阅" />

        <Border Grid.Row="1" Background="{ThemeResource ToolbarBackgroundBrush}" CornerRadius="8" Padding="5">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="UrlInput"
                        Style="{StaticResource InputTextBox}"
                        PlaceholderText="URL 下载（支持多行粘贴）"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="38"
                        MaxHeight="140" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button
                            Content="下载"
                            Click="OnDownloadClicked"
                            Style="{StaticResource SubtleButton}" />
                        <Button
                            Content="更新全部"
                            Click="OnRefreshAllClicked"
                            Style="{StaticResource SubtleButton}" />
                        <Button
                            Content="导入"
                            Click="OnImportClicked"
                            Style="{StaticResource SubtleButton}" />
                    </StackPanel>
                </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource StatusText}" Margin="0,2,0,0" TextWrapping="WrapWholeWords" />

        <GridView
            Grid.Row="3"
            x:Name="SubscriptionList"
            Padding="0,2,0,0"
            ItemsSource="{Binding Subscriptions}"
            ItemContainerStyle="{StaticResource SubscriptionListItem}"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="OnItemClicked"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SizeChanged="OnSubscriptionListSizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="SubscriptionWrapGrid" Orientation="Horizontal" ItemWidth="{Binding SubscriptionColumnWidth}" ItemHeight="104" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        PointerPressed="OnItemPointerPressed"
                        PointerReleased="OnItemPointerReleased"
                        PointerCanceled="OnItemPointerCanceled"
                        PointerCaptureLost="OnItemPointerCanceled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="2,6,8,6" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                            <Border
                                Width="5"
                                Background="{ThemeResource SubscriptionTrackBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch" />
                            <Border
                                x:Name="IndicatorActiveWrapper"
                                Width="5"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="IndicatorActiveScale" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border
                                    x:Name="IndicatorFill"
                                    Background="{Binding StateLineBrush}"
                                    CornerRadius="2"
                                    Opacity="{Binding StateLineOpacity}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="IndicatorPressScale" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>

                        <Border Grid.Column="1" Style="{StaticResource SubscriptionCard}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource MutedText}"
                                            Opacity="0.7"
                                            Text="{Binding DisplayUrl}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource MutedText}"
                                            Opacity="0.7"
                                            Text="{Binding UpdatedText}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MutedText}" Opacity="0.9">
                                        <Run Text="{Binding UsageText}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding ExpireText}" />
                                    </TextBlock>
                                    <ProgressBar
                                        Height="3"
                                        Margin="0,5,0,0"
                                        Maximum="{Binding ProgressMaximum}"
                                        Minimum="0"
                                        Value="{Binding ProgressValue}"
                                        Opacity="{Binding ProgressOpacity}"
                                        Foreground="{ThemeResource AccentBlueBrush}"
                                        Background="{ThemeResource SubscriptionTrackBrush}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Click="OnItemQuickRefresh"
                                    IsEnabled="{Binding CanRefresh}">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="刷新" Click="OnItemRefresh" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="重命名" Click="OnItemRename" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="复制 URL" Click="OnItemCopyUrl" CommandParameter="{Binding}" IsEnabled="{Binding HasUrl}" />
                                    <MenuFlyoutItem Text="打开文件位置" Click="OnItemOpenFile" CommandParameter="{Binding}" IsEnabled="{Binding IsFile}" />
                                    <MenuFlyoutItem Text="删除" Click="OnItemDelete" CommandParameter="{Binding}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Inactive">
                                    <VisualState.StateTriggers>
                                        <controls:BooleanStateTrigger IsActive="{Binding IsActive}" Value="False" />
                                    </VisualState.StateTriggers>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndicatorActiveScale" Storyboard.TargetProperty="ScaleY" To="0.05" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Active">
                                    <VisualState.StateTriggers>
                                        <controls:BooleanStateTrigger IsActive="{Binding IsActive}" Value="True" />
                                    </VisualState.StateTriggers>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndicatorActiveScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

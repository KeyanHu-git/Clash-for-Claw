<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClashForClaw.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClashForClaw"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="OnPageSizeChanged"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="GuideCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,9" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid x:Name="GuideLayoutRoot">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleText}" Text="运行说明" />
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="说明当前工作方式、回退逻辑和本地接口范围。"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border Style="{StaticResource HeroCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="默认边界" />
                        <Border Style="{StaticResource InsetPanel}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="默认只处理本机代理入口，不接管其他网络接口。" />
                                <TextBlock Text="系统代理默认关闭，可按需手动开启。" />
                                <TextBlock Text="订阅页显示的是代理链路状态，不代表整机流量。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid x:Name="GuideCardsGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="GuideColumnB" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="GuidePrinciplesCard" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="核心原则" />
                            <TextBlock Style="{StaticResource MutedText}" Text="默认只做本机适配层，不扩展额外网络面。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="订阅优先，失败再回退本地端口；不强制改写系统网络设置。" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideModesCard" Grid.Row="1" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="模式与回退" />
                            <TextBlock Text="优先使用订阅模式；订阅不可用时才回退到本地端口。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="本地端口模式仅使用当前填写的本地入口。" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideInterfacesCard" Grid.Row="2" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="接口与日志" />
                            <TextBlock Text="本地 API：/health /status /config /config/reload /service/*" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="URL 中的 token 会自动解析，不会在输入框回显。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="日志仅保存在本机。" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideServiceCard" Grid.Row="3" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="服务模式" />
                            <TextBlock Text="启用后会尝试注册 Windows 服务并在后台运行。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="若服务不可用，才会尝试计划任务回退；计划任务不是 Windows 服务。" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuideCreditsCard" Grid.Row="4" Style="{StaticResource GuideCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="背景来源" />
                            <TextBlock Text="动态背景素材来自和鲸社区，转载需标注来源。" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="作者：Shelter / MrIShelter，2025/08/04" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="来源：https://www.heywhale.com/mw/project/687e3f38c678037e34ebf61e" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

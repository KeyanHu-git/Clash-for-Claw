<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="ClashForClaw.Views.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:ClashForClaw.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SubscriptionListItem" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid>
                            <Border x:Name="FocusLayer" CornerRadius="14" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubscriptionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Page.Resources>

    <Grid x:Name="ContentLayout" Padding="{StaticResource PagePadding}" RowSpacing="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="920" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ImportActionColumn2.Width" Value="*" />
                        <Setter Target="ImportActionColumn3.Width" Value="*" />
                        <Setter Target="ImportActionRow2.Height" Value="0" />
                        <Setter Target="ImportActionRow3.Height" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RefreshAllButton.(Grid.Row)" Value="0" />
                        <Setter Target="RefreshAllButton.(Grid.Column)" Value="1" />
                        <Setter Target="RefreshAllButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ImportFileButton.(Grid.Row)" Value="0" />
                        <Setter Target="ImportFileButton.(Grid.Column)" Value="2" />
                        <Setter Target="ImportFileButton.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ImportActionColumn2.Width" Value="*" />
                        <Setter Target="ImportActionColumn3.Width" Value="0" />
                        <Setter Target="ImportActionRow2.Height" Value="Auto" />
                        <Setter Target="ImportActionRow3.Height" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="RefreshAllButton.(Grid.Row)" Value="0" />
                        <Setter Target="RefreshAllButton.(Grid.Column)" Value="1" />
                        <Setter Target="RefreshAllButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ImportFileButton.(Grid.Row)" Value="1" />
                        <Setter Target="ImportFileButton.(Grid.Column)" Value="0" />
                        <Setter Target="ImportFileButton.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ImportActionColumn2.Width" Value="*" />
                        <Setter Target="ImportActionColumn3.Width" Value="0" />
                        <Setter Target="ImportActionRow2.Height" Value="Auto" />
                        <Setter Target="ImportActionRow3.Height" Value="Auto" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadButton.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RefreshAllButton.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshAllButton.(Grid.Column)" Value="0" />
                        <Setter Target="RefreshAllButton.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ImportFileButton.(Grid.Row)" Value="2" />
                        <Setter Target="ImportFileButton.(Grid.Column)" Value="0" />
                        <Setter Target="ImportFileButton.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleText}" Text="订阅" />
            <TextBlock Style="{StaticResource MutedText}" Text="管理订阅源、导入文件和当前生效项。" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource HeroCard}">
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="添加与更新" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="输入 URL、导入本地文件，或刷新全部订阅。" TextWrapping="WrapWholeWords" />
                </StackPanel>

                <TextBox
                    x:Name="UrlInput"
                    Style="{StaticResource InputTextBox}"
                    PlaceholderText="输入订阅 URL，每行一条"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="56"
                    MaxHeight="160" />

                <Grid x:Name="ImportActionGrid" ColumnSpacing="5" RowSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ImportActionColumn2" Width="*" />
                        <ColumnDefinition x:Name="ImportActionColumn3" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ImportActionRow2" Height="0" />
                        <RowDefinition x:Name="ImportActionRow3" Height="0" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="DownloadButton"
                        Content="导入 URL"
                        Click="OnDownloadClicked"
                        Style="{StaticResource PrimaryButton}" />
                    <Button
                        x:Name="RefreshAllButton"
                        Grid.Column="1"
                        Content="刷新全部订阅"
                        Click="OnRefreshAllClicked"
                        Style="{StaticResource OverviewSecondaryButton}" />
                    <Button
                        x:Name="ImportFileButton"
                        Grid.Column="2"
                        Content="导入本地文件"
                        Click="OnImportClicked"
                        Style="{StaticResource OverviewSecondaryButton}" />
                </Grid>
            </StackPanel>
        </Border>

        <InfoBar
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
            Message="{Binding StatusMessage}"
            Severity="{Binding StatusSeverity}"
            Title="订阅状态" />

        <GridView
            Grid.Row="3"
            x:Name="SubscriptionList"
            Padding="0,2,0,0"
            ItemsSource="{Binding Subscriptions}"
            ItemContainerStyle="{StaticResource SubscriptionListItem}"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="OnItemClicked"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SizeChanged="OnSubscriptionListSizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="SubscriptionWrapGrid" Orientation="Horizontal" ItemWidth="{Binding SubscriptionColumnWidth}" ItemHeight="116" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        PointerPressed="OnItemPointerPressed"
                        PointerReleased="OnItemPointerReleased"
                        PointerCanceled="OnItemPointerCanceled"
                        PointerCaptureLost="OnItemPointerCanceled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="2,4,8,4" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                            <Border
                                Width="5"
                                Background="{ThemeResource SubscriptionTrackBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch" />
                            <Border
                                x:Name="IndicatorActiveWrapper"
                                Width="5"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="IndicatorActiveScale" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border
                                    x:Name="IndicatorFill"
                                    Background="{Binding StateLineBrush}"
                                    CornerRadius="2"
                                    Opacity="{Binding StateLineOpacity}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="IndicatorPressScale" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>

                        <Border Grid.Column="1" Style="{StaticResource SubscriptionCard}" Padding="0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Padding="10,8,10,7" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="{Binding SourceText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                            <Border
                                                Style="{StaticResource MetaBadge}"
                                                Background="{Binding StateBadgeBackgroundBrush}"
                                                Padding="5,2"
                                                CornerRadius="7"
                                                VerticalAlignment="Center">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StateBadgeForegroundBrush}" Text="{Binding StateLabel}" />
                                            </Border>

                                            <Button
                                                Style="{StaticResource IconButton}"
                                                Click="OnItemQuickRefresh"
                                                IsEnabled="{Binding CanRefresh}">
                                                <SymbolIcon Symbol="Refresh" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource MutedText}"
                                            FontSize="12"
                                            Text="{Binding DisplayUrl}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource MutedText}"
                                            FontSize="12"
                                            Text="{Binding UpdatedText}" />
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding UsageText}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" FontSize="12" Text="{Binding ExpireText}" />
                                    </Grid>
                                </Grid>

                                <ProgressBar
                                    Grid.Row="1"
                                    Height="4"
                                    Maximum="{Binding ProgressMaximum}"
                                    Minimum="0"
                                    Value="{Binding ProgressValue}"
                                    Opacity="{Binding ProgressOpacity}"
                                    Foreground="{ThemeResource AccentBlueBrush}"
                                    Background="{ThemeResource SubscriptionTrackBrush}" />
                            </Grid>

                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="刷新" Click="OnItemRefresh" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="重命名" Click="OnItemRename" CommandParameter="{Binding}" />
                                    <MenuFlyoutItem Text="复制 URL" Click="OnItemCopyUrl" CommandParameter="{Binding}" IsEnabled="{Binding HasUrl}" />
                                    <MenuFlyoutItem Text="打开文件位置" Click="OnItemOpenFile" CommandParameter="{Binding}" IsEnabled="{Binding IsFile}" />
                                    <MenuFlyoutItem Text="删除" Click="OnItemDelete" CommandParameter="{Binding}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Inactive">
                                    <VisualState.StateTriggers>
                                        <controls:BooleanStateTrigger IsActive="{Binding IsActive}" Value="False" />
                                    </VisualState.StateTriggers>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndicatorActiveScale" Storyboard.TargetProperty="ScaleY" To="0.05" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Active">
                                    <VisualState.StateTriggers>
                                        <controls:BooleanStateTrigger IsActive="{Binding IsActive}" Value="True" />
                                    </VisualState.StateTriggers>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndicatorActiveScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
